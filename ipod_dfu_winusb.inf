[Version]
Signature   = "$Windows NT$"
Class       = USBDevice
ClassGUID   = {88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider    = %ManufacturerName%
CatalogFile = ipod_dfu_winusb.cat
DriverVer   = 08/01/2026,1.0.0.0
PnpLockdown = 1

[Manufacturer]
%ManufacturerName% = Standard,NTamd64

[Standard.NTamd64]
%DeviceName_N3G%  = USB_Install, USB\VID_05AC&PID_1223
%DeviceName_N4G%  = USB_Install, USB\VID_05AC&PID_1225
%DeviceName_N5G%  = USB_Install, USB\VID_05AC&PID_1231
%DeviceName_N6G%  = USB_Install, USB\VID_05AC&PID_1232
%DeviceName_N7G%  = USB_Install, USB\VID_05AC&PID_1234
%DeviceName_N5GR% = USB_Install, USB\VID_05AC&PID_1242
%DeviceName_CLC%  = USB_Install, USB\VID_05AC&PID_1250

[USB_Install]
Include = winusb.inf
Needs   = WINUSB.NT

[USB_Install.Services]
Include = winusb.inf
Needs   = WINUSB.NT.Services

[USB_Install.HW]
AddReg = Dev_AddReg

[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{a5dcbf10-6530-11d2-901f-00c04fb951ed}"

[Strings]
ManufacturerName = "iPod Preservation Project"
DeviceName_N3G   = "iPod Nano 3G / Classic DFU (WinUSB)"
DeviceName_N4G   = "iPod Nano 4G DFU (WinUSB)"
DeviceName_N5G   = "iPod Nano 5G DFU (WinUSB)"
DeviceName_N6G   = "iPod Nano 6G DFU (WinUSB)"
DeviceName_N7G   = "iPod Nano 7G DFU (WinUSB)"
DeviceName_N5GR  = "iPod Nano 3G Recovery (WinUSB)"
DeviceName_CLC   = "iPod Classic Rev C DFU (WinUSB)"
